# Copy this file to ".env" (same folder) and fill in the value. Never commit .env.
#
# Supabase: Project → Connect (top bar) → "Session pooler" → URI.
# Use the SESSION pooler (port 5432); it works on IPv4 networks and hosts like Render.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres

# Optional
# MM_PORT=8000
# MM_SECURE_COOKIES=1    # set on the hosted (HTTPS) deployment
